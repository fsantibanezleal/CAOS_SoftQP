{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "engine_version",
    "n_cases",
    "default_case",
    "cases",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "softqp.artifact-index/v1"
    },
    "engine_version": {
      "type": "string"
    },
    "n_cases": {
      "type": "integer",
      "minimum": 1
    },
    "default_case": {
      "type": "string",
      "pattern": "^C[0-9]{2}$"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "title",
          "category",
          "manifest_path"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^C[0-9]{2}$"
          },
          "title": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "es"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "category": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "es"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "manifest_path": {
            "type": "string",
            "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_./-]+\\.json$"
          }
        }
      },
      "minItems": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_./-]+\\.json$"
      },
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/CAOS_SoftQP/contracts/case-index.schema.json"
}
