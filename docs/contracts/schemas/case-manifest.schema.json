{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "title",
    "category",
    "engine",
    "product_version",
    "seed",
    "source",
    "artifact",
    "lane",
    "gate"
  ],
  "properties": {
    "schema": {
      "const": "softqp.manifest/v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^C[0-9]{2}$"
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version"
      ],
      "properties": {
        "package": {
          "const": "softqp"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "product_version": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "source": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "format"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_./-]+\\.json$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "const": "json"
        }
      }
    },
    "lane": {
      "const": "precompute"
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "reasons"
      ],
      "properties": {
        "lane": {
          "const": "precompute"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "es"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/CAOS_SoftQP/contracts/case-manifest.schema.json"
}
