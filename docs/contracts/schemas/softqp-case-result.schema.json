{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/CAOS_SoftQP/contracts/softqp-case-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "title",
    "category",
    "seed",
    "source",
    "settings",
    "runs",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": "softqp.case-result/v2"
    },
    "case_id": {
      "type": "string",
      "pattern": "^C[0-9]{2}$"
    },
    "title": {
      "type": "object",
      "required": [
        "en",
        "es"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "category": {
      "type": "object",
      "required": [
        "en",
        "es"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "seed": {
      "type": "integer"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eps_abs",
        "eps_rel",
        "max_iter",
        "adaptive_rho_interval"
      ],
      "properties": {
        "eps_abs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "eps_rel": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_iter": {
          "type": "integer",
          "minimum": 1
        },
        "adaptive_rho_interval": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "state",
          "reason",
          "result"
        ],
        "properties": {
          "method": {
            "enum": [
              "lifted",
              "generalized",
              "asymmetric"
            ]
          },
          "state": {
            "enum": [
              "available",
              "failed",
              "incompatible"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "status",
                  "status_code",
                  "x",
                  "metrics",
                  "dimensions",
                  "iterations",
                  "setup_seconds",
                  "solve_seconds",
                  "elapsed_seconds"
                ],
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "status_code": {
                    "type": "integer"
                  },
                  "x": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "y": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "metrics": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "base_objective",
                          "penalty_objective",
                          "objective",
                          "hard_violation",
                          "lower_violation",
                          "upper_violation",
                          "slack",
                          "objective_gap_against_lifted"
                        ],
                        "properties": {
                          "base_objective": {
                            "type": "number"
                          },
                          "penalty_objective": {
                            "type": "number"
                          },
                          "objective": {
                            "type": "number"
                          },
                          "hard_violation": {
                            "type": "number"
                          },
                          "lower_violation": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          },
                          "upper_violation": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          },
                          "slack": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          },
                          "stationarity_residual": {
                            "type": "number"
                          },
                          "objective_gap_against_lifted": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "dimensions": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "variables",
                      "rows",
                      "nnz"
                    ],
                    "properties": {
                      "variables": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "rows": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "nnz": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "iterations": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "setup_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "solve_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "elapsed_seconds": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "available"
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "null"
                },
                "result": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "method",
                    "status",
                    "status_code",
                    "x",
                    "metrics",
                    "dimensions",
                    "iterations",
                    "setup_seconds",
                    "solve_seconds",
                    "elapsed_seconds"
                  ],
                  "properties": {
                    "method": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "status_code": {
                      "type": "integer"
                    },
                    "x": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "y": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "metrics": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "base_objective",
                            "penalty_objective",
                            "objective",
                            "hard_violation",
                            "lower_violation",
                            "upper_violation",
                            "slack",
                            "objective_gap_against_lifted"
                          ],
                          "properties": {
                            "base_objective": {
                              "type": "number"
                            },
                            "penalty_objective": {
                              "type": "number"
                            },
                            "objective": {
                              "type": "number"
                            },
                            "hard_violation": {
                              "type": "number"
                            },
                            "lower_violation": {
                              "type": "array",
                              "items": {
                                "type": "number"
                              }
                            },
                            "upper_violation": {
                              "type": "array",
                              "items": {
                                "type": "number"
                              }
                            },
                            "slack": {
                              "type": "array",
                              "items": {
                                "type": "number"
                              }
                            },
                            "stationarity_residual": {
                              "type": "number"
                            },
                            "objective_gap_against_lifted": {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "dimensions": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "variables",
                        "rows",
                        "nnz"
                      ],
                      "properties": {
                        "variables": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "rows": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "nnz": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "iterations": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "setup_seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "solve_seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "elapsed_seconds": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "incompatible"
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "unit",
          "soft"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^r[0-9]{4}$"
          },
          "label": {
            "type": "object",
            "required": [
              "en",
              "es"
            ],
            "additionalProperties": false,
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "soft": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
