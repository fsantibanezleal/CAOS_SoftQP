{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fsantibanezleal/CAOS_SoftQP/schemas/softqp-coupled-batch/1.0.0",
  "title": "Canonical directional coupled peak forecast batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "problem", "updates", "units", "description"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "directional-coupled-peak-batch"},
    "description": {"type": "string", "minLength": 1},
    "problem": {
      "type": "object", "additionalProperties": false,
      "required": ["P", "A", "q", "lower", "upper", "groups"],
      "properties": {
        "P": {"$ref": "#/$defs/csc"}, "A": {"$ref": "#/$defs/csc"},
        "q": {"$ref": "#/$defs/vector"},
        "lower": {"$ref": "#/$defs/bounds"}, "upper": {"$ref": "#/$defs/bounds"},
        "groups": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/group"}}
      }
    },
    "updates": {"type": "array", "minItems": 1, "maxItems": 512, "items": {
      "type": "object", "additionalProperties": false, "required": ["q", "lower", "upper"],
      "properties": {"q": {"$ref": "#/$defs/vector"}, "lower": {"$ref": "#/$defs/bounds"}, "upper": {"$ref": "#/$defs/bounds"}}
    }},
    "units": {
      "type": "object", "required": ["variable", "row", "q", "P_diagonal", "objective"],
      "properties": {"variable": {"$ref": "#/$defs/units"}, "row": {"$ref": "#/$defs/units"}, "q": {"$ref": "#/$defs/units"}, "P_diagonal": {"$ref": "#/$defs/units"}, "objective": {"type": "string", "minLength": 1}},
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "vector": {"type": "array", "minItems": 1, "maxItems": 16384, "items": {"type": "number"}},
    "bounds": {"type": "array", "minItems": 1, "maxItems": 16384, "items": {"type": ["number", "null"]}, "description": "null means negative infinity for a lower side and positive infinity for an upper side"},
    "units": {"type": "array", "minItems": 1, "maxItems": 16384, "items": {"type": "string", "minLength": 1}},
    "csc": {
      "type": "object", "additionalProperties": false, "required": ["shape", "data", "indices", "indptr"],
      "properties": {
        "shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 16384}},
        "data": {"type": "array", "maxItems": 4194304, "items": {"type": "number"}},
        "indices": {"type": "array", "maxItems": 4194304, "items": {"type": "integer", "minimum": 0}},
        "indptr": {"type": "array", "minItems": 2, "maxItems": 16385, "items": {"type": "integer", "minimum": 0, "maximum": 4194304}}
      }
    },
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["rows", "lower_scale", "upper_scale", "linear", "quadratic"],
      "properties": {
        "rows": {"type": "array", "minItems": 1, "maxItems": 16384, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "lower_scale": {"type": "array", "minItems": 1, "maxItems": 16384, "items": {"type": "number", "exclusiveMinimum": 0}},
        "upper_scale": {"type": "array", "minItems": 1, "maxItems": 16384, "items": {"type": "number", "exclusiveMinimum": 0}},
        "linear": {"type": "number", "minimum": 0}, "quadratic": {"type": "number", "minimum": 0}
      }
    }
  }
}
