{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/CAOS_SoftQP/contracts/softqp-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "default_case",
    "cases",
    "environment",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "softqp.index/v1"
    },
    "state": {
      "const": "development"
    },
    "default_case": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^C[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "title",
          "category",
          "path",
          "sha256",
          "failed"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^C[0-9]{2}$"
          },
          "title": {
            "type": "object",
            "required": [
              "en",
              "es"
            ],
            "additionalProperties": false,
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "category": {
            "type": "object",
            "required": [
              "en",
              "es"
            ],
            "additionalProperties": false,
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "es": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "path": {
            "type": "string",
            "pattern": "^C[0-9]{2}\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "failed": {
            "type": "boolean"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "platform",
        "packages"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "engine_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "engine_source_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "native_binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
