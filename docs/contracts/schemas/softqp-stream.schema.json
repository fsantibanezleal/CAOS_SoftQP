{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/CAOS_SoftQP/contracts/softqp-stream.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "softqp.stream/v1"
    },
    "case_id": {
      "const": "C12"
    },
    "protocol_id": {
      "const": "softqp-experiments-v1"
    },
    "engine_source": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "platform",
        "packages"
      ],
      "properties": {
        "python": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "engine_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "engine_source_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "native_binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "const": "C12"
        },
        "frames": {
          "const": 32
        },
        "horizon": {
          "const": 20
        },
        "dt_seconds": {
          "const": 0.2
        },
        "initial_state": {
          "type": "array",
          "prefixItems": [
            {
              "const": 1.6
            },
            {
              "const": 0.0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "velocity_impulses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "8": {
              "const": 0.8
            },
            "20": {
              "const": -0.6
            }
          },
          "required": [
            "8",
            "20"
          ]
        },
        "policy": {
          "const": "Independent stock lifting drives the common plant trajectory. Every compared method receives identical state inputs. These are paired solver observations, not separate controller rollouts."
        },
        "methods": {
          "type": "array",
          "prefixItems": [
            {
              "const": "lifted"
            },
            {
              "const": "generalized"
            },
            {
              "const": "asymmetric"
            },
            {
              "const": "daqp"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "modes": {
          "type": "array",
          "prefixItems": [
            {
              "const": "cold"
            },
            {
              "const": "warm"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "timing": {
          "const": "one documented stream observation per frame; no statistical superiority claim from it"
        }
      },
      "required": [
        "case_id",
        "frames",
        "horizon",
        "dt_seconds",
        "initial_state",
        "velocity_impulses",
        "policy",
        "methods",
        "modes",
        "timing"
      ]
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "time_seconds": {
            "type": "number",
            "minimum": 0
          },
          "state": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "velocity_impulse": {
            "type": "number"
          },
          "oracle_objective": {
            "type": "number"
          },
          "objective_constant": {
            "type": "number"
          },
          "oracle_horizon_cost": {
            "type": "number"
          },
          "oracle_control": {
            "type": "number"
          },
          "applied_control": {
            "type": "number"
          },
          "next_state": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "generation_seconds": {
            "type": "number",
            "minimum": 0
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "method": {
                  "enum": [
                    "lifted",
                    "generalized",
                    "asymmetric",
                    "daqp",
                    "flex",
                    "elastiqp"
                  ]
                },
                "mode": {
                  "enum": [
                    "cold",
                    "warm"
                  ]
                },
                "state": {
                  "enum": [
                    "accepted",
                    "incompatible",
                    "failed",
                    "accuracy-rejected",
                    "timeout",
                    "resource-limit",
                    "oracle-failed"
                  ]
                },
                "reason": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "metrics": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "base_objective",
                        "penalty_objective",
                        "objective",
                        "hard_violation",
                        "lower_violation",
                        "upper_violation",
                        "slack"
                      ],
                      "properties": {
                        "base_objective": {
                          "type": "number"
                        },
                        "penalty_objective": {
                          "type": "number"
                        },
                        "objective": {
                          "type": "number"
                        },
                        "hard_violation": {
                          "type": "number"
                        },
                        "lower_violation": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "upper_violation": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "slack": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "stationarity_residual": {
                          "anyOf": [
                            {
                              "type": "number",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "objective_gap_against_lifted": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "normalized_gap": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "elapsed_seconds": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "update_seconds": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "workspace_setup_seconds": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "result": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "method",
                        "status",
                        "status_code",
                        "x",
                        "metrics",
                        "dimensions",
                        "iterations",
                        "setup_seconds",
                        "solve_seconds",
                        "elapsed_seconds"
                      ],
                      "properties": {
                        "method": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "status_code": {
                          "type": "integer"
                        },
                        "x": {
                          "anyOf": [
                            {
                              "type": "array",
                              "items": {
                                "type": "number"
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "y": {
                          "anyOf": [
                            {
                              "type": "array",
                              "items": {
                                "type": "number"
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "metrics": {
                          "anyOf": [
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "base_objective",
                                "penalty_objective",
                                "objective",
                                "hard_violation",
                                "lower_violation",
                                "upper_violation",
                                "slack"
                              ],
                              "properties": {
                                "base_objective": {
                                  "type": "number"
                                },
                                "penalty_objective": {
                                  "type": "number"
                                },
                                "objective": {
                                  "type": "number"
                                },
                                "hard_violation": {
                                  "type": "number"
                                },
                                "lower_violation": {
                                  "type": "array",
                                  "items": {
                                    "type": "number"
                                  }
                                },
                                "upper_violation": {
                                  "type": "array",
                                  "items": {
                                    "type": "number"
                                  }
                                },
                                "slack": {
                                  "type": "array",
                                  "items": {
                                    "type": "number"
                                  }
                                },
                                "stationarity_residual": {
                                  "anyOf": [
                                    {
                                      "type": "number",
                                      "minimum": 0
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "objective_gap_against_lifted": {
                                  "anyOf": [
                                    {
                                      "type": "number"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "dimensions": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "variables",
                            "rows",
                            "nnz"
                          ],
                          "properties": {
                            "variables": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "rows": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "nnz": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        },
                        "iterations": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "setup_seconds": {
                          "type": "number",
                          "minimum": 0
                        },
                        "solve_seconds": {
                          "type": "number",
                          "minimum": 0
                        },
                        "elapsed_seconds": {
                          "type": "number",
                          "minimum": 0
                        },
                        "backend_settings": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "method",
                "mode",
                "state",
                "reason",
                "metrics",
                "normalized_gap",
                "elapsed_seconds",
                "update_seconds",
                "workspace_setup_seconds",
                "result"
              ]
            },
            "minItems": 8,
            "maxItems": 8
          }
        },
        "required": [
          "frame",
          "time_seconds",
          "state",
          "velocity_impulse",
          "oracle_objective",
          "objective_constant",
          "oracle_horizon_cost",
          "oracle_control",
          "applied_control",
          "next_state",
          "generation_seconds",
          "runs"
        ]
      },
      "minItems": 32,
      "maxItems": 32
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "incompatible": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "accuracy-rejected": {
          "type": "integer",
          "minimum": 0
        },
        "timeout": {
          "type": "integer",
          "minimum": 0
        },
        "resource-limit": {
          "type": "integer",
          "minimum": 0
        },
        "oracle-failed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": []
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "protocol_id",
    "engine_source",
    "environment",
    "specification",
    "frames",
    "counts",
    "limitations"
  ]
}
