{
  "$id": "urn:softqp:softqp.test-native-run/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "fixture_only": {
      "type": "boolean"
    },
    "inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "population_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "role": {
      "const": "test"
    },
    "roster_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attempt": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "frame_id": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "minLength": 1,
            "type": "string"
          },
          "terminal": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          }
        },
        "required": [
          "frame_id",
          "attempt",
          "terminal",
          "state",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "const": "softqp.test-native-run/2"
    },
    "scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "test_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "workers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "fixture_only",
    "scope_sha256",
    "roster_sha256",
    "role",
    "test_sha256",
    "profile_sha256",
    "population_sha256",
    "inventory_sha256",
    "workers",
    "rows"
  ],
  "type": "object"
}
